@page
@model WebDashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h2>FILE Group</h2>
    <p>Distributed file storage engine — Phase 1</p>
    <div class="actions">
        <a class="btn" href="/Files">Browse Files</a>
        <a class="btn" href="http://localhost:9090/metrics" target="_blank">Prometheus Metrics</a>
    </div>
</section>

<section class="status">
    <h3>Connection</h3>
    <p>Engine: <code>@Model.EngineAddress</code></p>
    <p>Status: <span class="badge @(Model.EngineOk ? "ok" : "err")">@(Model.EngineOk ? "connected" : "unreachable")</span></p>
</section>
