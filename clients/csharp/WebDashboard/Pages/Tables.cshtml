@page
@model WebDashboard.Pages.TablesModel
@{
    ViewData["Title"] = "Tables";
}

<h2>Tables</h2>

@if (Model.Created)
{
    <div class="status" style="border-color:var(--ok);margin-bottom:1rem;">
        <p style="color:var(--ok);">Table created.</p>
    </div>
}

<details style="margin-bottom:1.5rem;">
    <summary style="cursor:pointer;color:var(--accent);">+ Create Table</summary>
    <form method="post" style="margin-top:1rem;display:flex;flex-direction:column;gap:.75rem;max-width:400px;">
        @Html.AntiForgeryToken()
        <div style="display:flex;gap:.75rem;">
            <div style="flex:1;">
                <label style="font-size:.8rem;color:var(--muted);">Table ID</label>
                <input type="number" name="TableId" required min="1" style="width:100%;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.35rem .5rem;" />
            </div>
            <div style="flex:1;">
                <label style="font-size:.8rem;color:var(--muted);">Group ID</label>
                <input type="number" name="GroupId" value="1" required min="1" style="width:100%;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.35rem .5rem;" />
            </div>
        </div>
        <div>
            <label style="font-size:.8rem;color:var(--muted);">Name</label>
            <input type="text" name="TableName" required style="width:100%;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.35rem .5rem;" />
        </div>
        <div style="display:flex;gap:.75rem;">
            <div style="flex:1;">
                <label style="font-size:.8rem;color:var(--muted);">Chunk Size (bytes)</label>
                <input type="number" name="ChunkSize" value="0" style="width:100%;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.35rem .5rem;" />
            </div>
            <div style="flex:1;">
                <label style="font-size:.8rem;color:var(--muted);">Replication</label>
                <input type="number" name="ReplicationFactor" value="0" min="0" max="255" style="width:100%;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.35rem .5rem;" />
            </div>
        </div>
        <div style="display:flex;gap:.75rem;">
            <div style="flex:1;">
                <label style="font-size:.8rem;color:var(--muted);">Max Versions</label>
                <input type="number" name="MaxVersions" value="0" min="0" style="width:100%;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.35rem .5rem;" />
            </div>
            <div style="flex:1;">
                <label style="font-size:.8rem;color:var(--muted);">Expires In (days)</label>
                <input type="number" name="ExpiresInDays" value="0" min="0" style="width:100%;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.35rem .5rem;" />
            </div>
        </div>
        <button type="submit" class="btn" style="align-self:flex-start;cursor:pointer;">Create</button>
    </form>
</details>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="status" style="border-color:var(--err);margin-bottom:1rem;">
        <p style="color:var(--err);">@Model.Error</p>
    </div>
}

@if (Model.Tables.Count == 0)
{
    <div class="empty">
        <p>No tables found.</p>
        <p style="font-size:.85rem;margin-top:.5rem;">Tables are configured in the engine's config. Upload a file to see tables here.</p>
    </div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Table ID</th>
                <th>Name</th>
                <th>Group</th>
                <th>Files</th>
                <th>Active</th>
                <th>Deleted</th>
                <th>Size</th>
                <th>Chunk</th>
                <th>Max&nbsp;Ver</th>
                <th>Expires</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var t in Model.Tables)
        {
            var segs = Model.AllSegments.Where(s => s.GroupId == t.GroupId && s.TableId == t.TableId).ToList();
            var rowId = $"seg-{t.GroupId}-{t.TableId}";
            <tr>
                <td class="mono">
                    <a href="/Files?group=@t.GroupId&table=@t.TableId">@t.TableId</a>
                </td>
                <td>@t.Name</td>
                <td>@t.GroupId</td>
                <td class="mono">@t.FileCount</td>
                <td class="mono"><span class="badge ok">@t.ActiveCount</span></td>
                <td class="mono"><span class="badge err">@t.DeletedCount</span></td>
                <td class="mono">@FormatSize(t.TotalSize)</td>
                <td class="mono">@(t.ChunkSize > 0 ? FormatSize(t.ChunkSize) : "—")</td>
                <td class="mono">@(t.MaxVersions > 0 ? t.MaxVersions.ToString() : "—")</td>
                <td class="mono">@(t.ExpiresInDays > 0 ? $"{t.ExpiresInDays}d" : "never")</td>
                <td>
                    @if (segs.Count > 0)
                    {
                        <button onclick="var r=document.getElementById('@rowId');r.style.display=r.style.display==='none'?'':'none';this.textContent=r.style.display==='none'?'▸ Segs (@segs.Count)':'▾ Segs (@segs.Count)';" style="background:var(--surface);color:var(--accent);border:1px solid var(--border);border-radius:var(--radius);padding:.15rem .5rem;cursor:pointer;font-size:.75rem;white-space:nowrap;">▸ Segs (@segs.Count)</button>
                    }
                    else
                    {
                        <span style="color:var(--muted);font-size:.75rem;">—</span>
                    }
                </td>
            </tr>
            @if (segs.Count > 0)
            {
            <tr id="@rowId" style="display:none;">
                <td colspan="11" style="padding:.5rem 1rem;background:var(--surface);border-bottom:1px solid var(--border);">
                    <div style="font-size:.8rem;color:var(--muted);margin-bottom:.35rem;">Segment files for table @t.TableId:</div>
                    <table style="margin:0;font-size:.75rem;">
                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Node</th>
                                <th>Type</th>
                                <th>Chunks</th>
                                <th>Used</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in segs)
                        {
                            <tr>
                                <td class="mono" style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@s.FileName">@s.FileName</td>
                                <td>@s.NodeId</td>
                                <td><span class="badge @(s.IsPage ? "" : "")" style="font-size:.7rem;">@(s.IsPage ? "page" : "std")</span></td>
                                <td class="mono">@s.ChunkCount</td>
                                <td class="mono">@FormatSize(s.UsedBytes)</td>
                                <td class="mono">@FormatSize(s.TotalSize)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </td>
            </tr>
            }
        }
        </tbody>
    </table>
}

@functions {
    static string FormatSize(ulong bytes)
    {
        if (bytes == 0) return "—";
        string[] suf = { "B", "KB", "MB", "GB" };
        int i = 0;
        double d = bytes;
        while (d >= 1024 && i < suf.Length - 1) { d /= 1024; i++; }
        return d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " " + suf[i];
    }
}
