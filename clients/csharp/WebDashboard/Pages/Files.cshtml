@page "{handler?}"
@model WebDashboard.Pages.FilesModel
@{
    ViewData["Title"] = "Files";
}

<div class="bar">
    <h2>Files</h2>
    <div class="actions">
        <a href="/Upload?table=@Model.SelectedTable" class="btn" style="border-color:var(--accent);">+ Upload</a>
    <form method="get" class="actions" style="margin:0;">
        <select name="group" style="background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.4rem .6rem;font-size:.85rem;">
            <option value="0">All Groups</option>
            @foreach (var t in Model.Tables.Select(t => t.GroupId).Distinct())
            {
                <!option value="@t" selected=@(Model.SelectedGroup == t)>Group @t</!option>
            }
        </select>
        <select name="table" style="background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.4rem .6rem;font-size:.85rem;">
            <option value="0">All Tables</option>
            @foreach (var t in Model.Tables)
            {
                <!option value="@t.TableId" selected=@(Model.SelectedTable == t.TableId)>@t.Name (@t.TableId)</!option>
            }
        </select>
        <button type="submit" class="btn">Filter</button>
    </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="status" style="border-color:var(--err);margin-bottom:1rem;">
        <p style="color:var(--err);">@Model.Error</p>
    </div>
}

@if (Model.Files.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <div class="empty">
        <p>No files yet.</p>
        <p style="font-size:.85rem;margin-top:.5rem;">Upload a file via the DemoLocal tool to see it here.</p>
    </div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Logical ID</th>
                <th>Group</th>
                <th>Table</th>
                <th>Latest Version</th>
                <th>State</th>
                <th>Size</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var f in Model.Files)
        {
            <tr>
                <td class="mono"><a href="/File/@f.LogicalFileId">@f.LogicalFileId</a></td>
                <td>@f.GroupId</td>
                <td>@f.TableId</td>
                <td class="mono">@f.LatestVersion</td>
                <td><span class="badge @(f.State == Filegroup.Engine.FileState.FileActive ? "ok" : "err")">@f.State</span></td>
                <td class="mono">@FormatSize(f.TotalSize)</td>
                <td class="mono" style="font-size:.8rem;">@FormatTimestamp(f.CreatedAtUs)</td>
            </tr>
        }
        </tbody>
    </table>
}

@functions {
    static string FormatSize(ulong bytes)
    {
        if (bytes == 0) return "—";
        string[] suf = { "B", "KB", "MB", "GB" };
        int i = 0;
        double d = bytes;
        while (d >= 1024 && i < suf.Length - 1) { d /= 1024; i++; }
        return d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " " + suf[i];
    }

    static string FormatTimestamp(ulong us)
    {
        if (us == 0) return "—";
        try
        {
            var dt = DateTimeOffset.FromUnixTimeSeconds((long)(us / 1_000_000));
            return dt.ToString("yyyy-MM-dd HH:mm");
        }
        catch { return us.ToString(); }
    }
}
