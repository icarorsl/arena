@page
@model WebDashboard.Pages.SegmentsModel
@{
    ViewData["Title"] = "Segments";
}

<h2>Segment Files</h2>
<p style="color:var(--muted);font-size:.85rem;margin-bottom:1rem;">Internal storage files managed by the engine on disk.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="status" style="border-color:var(--err);margin-bottom:1rem;">
        <p style="color:var(--err);">@Model.Error</p>
    </div>
}

@if (Model.Segments.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <div class="empty">
        <p>No segment files found.</p>
        <p style="font-size:.85rem;margin-top:.5rem;">Segments are created when files are uploaded.</p>
    </div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>File Name</th>
                <th>Node</th>
                <th>Group</th>
                <th>Table</th>
                <th>Type</th>
                <th>Chunks</th>
                <th>Used</th>
                <th>Total</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Segments)
        {
            <tr>
                <td class="mono" style="font-size:.8rem;max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@s.FileName">@s.FileName</td>
                <td>@s.NodeId</td>
                <td>@s.GroupId</td>
                <td>@s.TableId</td>
                <td><span class="badge @(s.IsPage ? "warn" : "")">@(s.IsPage ? "page" : "standard")</span></td>
                <td class="mono">@s.ChunkCount</td>
                <td class="mono">@FormatSize(s.UsedBytes)</td>
                <td class="mono">@FormatSize(s.TotalSize)</td>
                <td class="mono" style="font-size:.8rem;">@FormatTimestamp(s.CreatedAtUs)</td>
            </tr>
        }
        </tbody>
    </table>

    <div style="margin-top:1rem;color:var(--muted);font-size:.8rem;">
        @Model.Segments.Count segment(s) &middot;
        Total used: @FormatSize((ulong)Model.Segments.Sum(s => (long)s.UsedBytes))
    </div>
}

@functions {
    static string FormatSize(ulong bytes)
    {
        if (bytes == 0) return "—";
        string[] suf = { "B", "KB", "MB", "GB" };
        int i = 0;
        double d = bytes;
        while (d >= 1024 && i < suf.Length - 1) { d /= 1024; i++; }
        return d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " " + suf[i];
    }

    static string FormatTimestamp(ulong us)
    {
        if (us == 0) return "—";
        try
        {
            var dt = DateTimeOffset.FromUnixTimeSeconds((long)(us / 1_000_000));
            return dt.ToString("yyyy-MM-dd HH:mm");
        }
        catch { return us.ToString(); }
    }
}
