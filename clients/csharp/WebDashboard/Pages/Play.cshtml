@page "{id:long}"
@model WebDashboard.Pages.PlayModel
@{
    ViewData["Title"] = $"Play {RouteData.Values["id"]}";
    Layout = null; // fullscreen, no chrome
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Play File #@RouteData.Values["id"]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #000; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        video { max-width: 100vw; max-height: 100vh; outline: none; }
        .err { color: #f87171; text-align: center; padding: 2rem; font-family: sans-serif; }
        .back { position: fixed; top: 1rem; left: 1rem; color: #888; text-decoration: none; font-size: .85rem; font-family: sans-serif; z-index: 10; }
        .back:hover { color: #fff; }
        .info { position: fixed; top: 1rem; right: 1rem; color: #666; font-family: sans-serif; font-size: .75rem; text-align: right; z-index: 10; line-height: 1.5; }
        .info span { color: #aaa; }
    </style>
</head>
<body>
    <a href="/File/@RouteData.Values["id"]" class="back">← Back</a>
    <div class="info">
        <div>Logical File Id<span>#@RouteData.Values["id"]</span></div>
        <div>Table <span>@Model.TableId</span> · Group <span>@Model.GroupId</span></div>
        <div>Version <span>@Model.VersionNumber</span> · <span>@Model.VersionState</span></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="err">
            <p>@Model.Error</p>
        </div>
    }
    else
    {
        var version = HttpContext.Request.Query["version"].FirstOrDefault() ?? "0";
        <video controls preload="metadata" playsinline
               src="/File/@RouteData.Values["id"]?handler=Download&version=@version">
        </video>
    }
</body>
</html>
