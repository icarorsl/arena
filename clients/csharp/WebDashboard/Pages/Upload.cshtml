@page
@model WebDashboard.Pages.UploadModel
@{
    ViewData["Title"] = "Upload";
}

<h2>Upload File@(Model.ExistingFileId > 0 ? $" — New Version for #" + Model.ExistingFileId : "")</h2>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="status" style="border-color:var(--err);margin-bottom:1rem;">
        <p style="color:var(--err);">@Model.Error</p>
    </div>
}

@if (Model.Done)
{
    <div class="status" style="border-color:var(--ok);margin-bottom:1.5rem;text-align:center;">
        <p style="color:var(--ok);font-size:1.1rem;margin-bottom:.75rem;">
            ✅ Upload complete
        </p>
        <p style="color:var(--muted);margin-bottom:1rem;">
            File <strong>#@Model.UploadedFileId</strong>, version <strong>@Model.UploadedVersion</strong>, @FormatSize((ulong)Model.UploadedSize)
        </p>
        <div class="actions">
            <a href="/File/@Model.UploadedFileId" class="btn" style="border-color:var(--accent);">View file</a>
            <a href="/Files" class="btn" style="border-color:var(--ok);">OK</a>
        </div>
    </div>
}

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div style="display:flex;flex-direction:column;gap:1rem;max-width:480px;">
        <div>
            <label style="display:block;font-size:.85rem;color:var(--muted);margin-bottom:.3rem;">File</label>
            <input type="file" name="UploadedFile" required
                   style="background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.5rem;width:100%;" />
        </div>
        <div style="display:flex;gap:1rem;">
            <div style="flex:1;">
                <label style="display:block;font-size:.85rem;color:var(--muted);margin-bottom:.3rem;">Group</label>
                <input type="number" name="GroupId" value="1" min="1"
                       style="background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.4rem .6rem;width:100%;" />
            </div>
            <div style="flex:1;">
                <label style="display:block;font-size:.85rem;color:var(--muted);margin-bottom:.3rem;">Table</label>
                <input type="number" name="TableId" value="1" min="1"
                       style="background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:.4rem .6rem;width:100%;" />
            </div>
        </div>
        <button type="submit" class="btn" style="align-self:flex-start;cursor:pointer;">
            Upload
        </button>
    </div>
</form>

@functions {
    static string FormatSize(ulong bytes)
    {
        if (bytes == 0) return "—";
        string[] suf = { "B", "KB", "MB", "GB" };
        int i = 0;
        double d = bytes;
        while (d >= 1024 && i < suf.Length - 1) { d /= 1024; i++; }
        return d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " " + suf[i];
    }
}
